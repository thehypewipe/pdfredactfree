    let redactions = {}; // pageNum -> Array of { x, y, w, h, cw, ch }
    let selectedBoxIndex = -1;
    let activeHandle = null; // 'nw', 'ne', 'se', 'sw', 'n', 's', 'e', 'w', 'move'
    let dragStartX = 0, dragStartY = 0;
    let boxInitialState = null;
    let isDrawingNew = false;
    let drawStartX = 0, drawStartY = 0;

    const HANDLE_SIZE = 9;

    // Dynamic On-Demand Script Loader for PDF.js and pdf-lib
    let pdfLibrariesPromise = null;

    function loadPdfLibraries() {
      if (pdfLibrariesPromise) return pdfLibrariesPromise;

      if (window.pdfjsLib && window.PDFLib) {
        if (window.pdfjsLib.GlobalWorkerOptions && !window.pdfjsLib.GlobalWorkerOptions.workerSrc) {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }
        return Promise.resolve();
      }

      pdfLibrariesPromise = new Promise(function (resolve, reject) {
        let pdfJsLoaded = Boolean(window.pdfjsLib);
        let pdfLibLoaded = Boolean(window.PDFLib);

        function checkDone() {
          if (pdfJsLoaded && pdfLibLoaded) {
            if (window.pdfjsLib && window.pdfjsLib.GlobalWorkerOptions) {
              window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
            }
            resolve();
          }
        }

        if (!pdfJsLoaded) {
          const s1 = document.createElement('script');
          s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
          s1.async = true;
          s1.onload = function () {
            pdfJsLoaded = true;
            checkDone();
          };
          s1.onerror = function () {
            reject(new Error('Failed to load PDF.js'));
          };
          document.head.appendChild(s1);
        }

        if (!pdfLibLoaded) {
          const s2 = document.createElement('script');
          s2.src = 'https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js';
          s2.async = true;
          s2.onload = function () {
            pdfLibLoaded = true;
            checkDone();
          };
          s2.onerror = function () {
            reject(new Error('Failed to load pdf-lib'));
          };
          document.head.appendChild(s2);
        }

        checkDone();
      });

      return pdfLibrariesPromise;
    }

    // 100% On-Demand Script Injection (Triggered strictly on user intent)
    function init() {
      const input = document.getElementById('pdf-file-input');
      const dropzone = document.getElementById('pdf-dropzone');

      if (!input) return;

      // Pre-warm on user interaction (hover, dragenter, click, touch)
      function onUserIntent() {
        loadPdfLibraries().catch(function () {});
      }

      input.addEventListener('focus', onUserIntent, { once: true });
      input.addEventListener('change', function (e) {
        onUserIntent();
        const file = e.target.files && e.target.files[0];
        if (file) handleFile(file);
      });

      if (dropzone) {
        dropzone.addEventListener('click', onUserIntent, { once: true });
        dropzone.addEventListener('touchstart', onUserIntent, { passive: true, once: true });
        dropzone.addEventListener('dragenter', function (e) {
          e.preventDefault();
          onUserIntent();
          dropzone.style.borderColor = '#ffffff';
        });
        dropzone.addEventListener('dragover', function (e) {
          e.preventDefault();
          onUserIntent();
          dropzone.style.borderColor = '#ffffff';
        });
        dropzone.addEventListener('dragleave', function (e) {
          e.preventDefault();
          dropzone.style.borderColor = '#27272a';
        });
        dropzone.addEventListener('drop', function (e) {
          e.preventDefault();
          dropzone.style.borderColor = '#27272a';
          const file = e.dataTransfer && e.dataTransfer.files[0];
          if (file) handleFile(file);
        });
      }

      // Document & Navigation Controls
      document.getElementById('btn-new-file')?.addEventListener('click', resetToDropzone);
      document.getElementById('btn-prev')?.addEventListener('click', () => stepPage(-1));
      document.getElementById('btn-next')?.addEventListener('click', () => stepPage(1));
      document.getElementById('btn-mode-scroll')?.addEventListener('click', toggleScrollMode);
      document.getElementById('btn-delete-selected')?.addEventListener('click', deleteSelectedBox);
      document.getElementById('btn-undo')?.addEventListener('click', undoLastAction);
      document.getElementById('btn-zoom-in')?.addEventListener('click', () => { scale += 0.2; renderPage(currentPage); });
      document.getElementById('btn-zoom-out')?.addEventListener('click', () => { if (scale > 0.6) { scale -= 0.2; renderPage(currentPage); } });
      document.getElementById('btn-clear')?.addEventListener('click', () => {
        redactions[currentPage] = [];
        selectedBoxIndex = -1;
        updateDeleteButton();
        drawCanvasOverlay();
      });

      // Step Action Button Listeners
      document.getElementById('btn-next-step-1')?.addEventListener('click', () => goToStep(2));
      document.getElementById('btn-back-step-2')?.addEventListener('click', () => goToStep(1));
      document.getElementById('btn-next-step-2')?.addEventListener('click', () => goToStep(3));
      document.getElementById('btn-back-step-3')?.addEventListener('click', () => goToStep(2));
      document.getElementById('btn-download')?.addEventListener('click', downloadFlattenedRedacted);

      // Workflow Stepper Direct Header Navigation
      document.getElementById('btn-step-1')?.addEventListener('click', () => goToStep(1));
      document.getElementById('btn-step-2')?.addEventListener('click', () => goToStep(2));
      document.getElementById('btn-step-3')?.addEventListener('click', () => goToStep(3));
      document.getElementById('btn-step-4')?.addEventListener('click', () => {
        if (hasDownloaded) openShareModal();
        else downloadFlattenedRedacted();
      });

      // Post-Download Viral Share Modal Controls
      document.getElementById('btn-modal-close-icon')?.addEventListener('click', closeShareModal);
      document.getElementById('btn-modal-close')?.addEventListener('click', closeShareModal);
      document.getElementById('btn-modal-new')?.addEventListener('click', () => {
        closeShareModal();
        resetToDropzone();
      });

      const modalBackdrop = document.getElementById('share-modal');
      modalBackdrop?.addEventListener('click', (e) => {
        if (e.target === modalBackdrop) closeShareModal();
      });

      attachCanvasEvents();
      attachShortcuts();
    }

    let currentStep = 1; // 1: Blackout, 2: Review & Edit, 3: Export & Download, 4: Share
    let hasDownloaded = false;

    function updateWorkflowStep(stepNumber) {
      for (let i = 1; i <= 4; i++) {
        const item = document.getElementById(`step-item-${i}`);
        if (!item) continue;
        item.classList.remove('active', 'completed');
        if (i < stepNumber) {
          item.classList.add('completed');
        } else if (i === stepNumber) {
          item.classList.add('active');
        }
      }
    }

    function goToStep(step) {
      currentStep = step;
      updateWorkflowStep(step);

      const action1 = document.getElementById('step-action-1');
      const action2 = document.getElementById('step-action-2');
      const action3 = document.getElementById('step-action-3');
      const statusPill = document.getElementById('status-pill');

      action1?.classList.add('hidden');
      action2?.classList.add('hidden');
      action3?.classList.add('hidden');

      if (step === 1) {
        action1?.classList.remove('hidden');
        setMode('blackout');
        if (statusPill) {
          statusPill.setAttribute('data-i18n', 'step1Status');
          statusPill.innerHTML = window.__pdfDict?.step1Status || 'Step 1: <b>Blackout</b> (Draw with 1 finger • Use 2 fingers to scroll or tap ✋ Scroll)';
        }
      } else if (step === 2) {
        action2?.classList.remove('hidden');
        setMode('edit');
        if (statusPill) {
          statusPill.setAttribute('data-i18n', 'step2Status');
          statusPill.innerHTML = window.__pdfDict?.step2Status || 'Step 2: <b>Review & Edit</b> (Tap any box to resize or move • 🗑️ to delete)';
        }
      } else if (step === 3) {
        action3?.classList.remove('hidden');
        setMode('review');
        if (statusPill) {
          statusPill.setAttribute('data-i18n', 'step3Status');
          statusPill.innerHTML = window.__pdfDict?.step3Status || 'Step 3: <b>Export</b> (Inspect final preview and click Download PDF)';
        }
      } else if (step === 4) {
        if (hasDownloaded) openShareModal();
        else goToStep(3);
      }
    }

    function toggleScrollMode() {
      if (currentMode === 'scroll') {
        if (currentStep === 1) setMode('blackout');
        else if (currentStep === 2) setMode('edit');
        else setMode('review');
      } else {
        setMode('scroll');
      }
    }

    function openShareModal() {
      const modal = document.getElementById('share-modal');
      const overlay = document.getElementById('export-loading-overlay');
      if (!modal) return;
      // Prevent any modal overlap with loading overlay
      if (overlay) {
        overlay.classList.remove('active');
        overlay.classList.add('hidden');
      }
      currentStep = 4;
      updateWorkflowStep(4);
      modal.classList.remove('hidden');
      void modal.offsetHeight; // Force reflow for CSS transition
      modal.classList.add('active');
    }

    function closeShareModal() {
      const modal = document.getElementById('share-modal');
      if (!modal) return;
      modal.classList.remove('active');
      setTimeout(function () {
        modal.classList.add('hidden');
        goToStep(3);
      }, 250);
    }

    function setMode(mode) {
      currentMode = mode;
      const sBtn = document.getElementById('btn-mode-scroll');
      const statusPill = document.getElementById('status-pill');
      const overlay = document.getElementById('blackout-overlay-canvas');
      const wrapper = document.getElementById('canvas-wrapper');

      sBtn?.classList.remove('btn-active');

      if (mode === 'blackout') {
        selectedBoxIndex = -1;
        updateDeleteButton();
        if (overlay) {
          overlay.style.cursor = 'crosshair';
          overlay.style.touchAction = 'none';
        }
        if (wrapper) wrapper.style.touchAction = 'none';
      } else if (mode === 'edit') {
        if (overlay) {
          overlay.style.cursor = 'default';
          overlay.style.touchAction = 'none';
        }
        if (wrapper) wrapper.style.touchAction = 'none';
      } else if (mode === 'scroll') {
        sBtn?.classList.add('btn-active');
        selectedBoxIndex = -1;
        updateDeleteButton();
        if (statusPill) {
          statusPill.setAttribute('data-i18n', 'modeScrollPill');
          statusPill.innerHTML = window.__pdfDict?.modeScrollPill || 'Mode: <b>Scroll</b> (Swipe anywhere with 1 finger to navigate page)';
        }
        if (overlay) {
          overlay.style.cursor = 'grab';
          overlay.style.touchAction = 'pan-y pinch-zoom';
        }
        if (wrapper) wrapper.style.touchAction = 'pan-y pinch-zoom';
      } else if (mode === 'review') {
        selectedBoxIndex = -1;
        updateDeleteButton();
        if (overlay) {
          overlay.style.cursor = 'default';
          overlay.style.touchAction = 'pan-y pinch-zoom';
        }
        if (wrapper) wrapper.style.touchAction = 'pan-y pinch-zoom';
      }
      drawCanvasOverlay();
    }

    function updateDeleteButton() {
      const delBtn = document.getElementById('btn-delete-selected');
      if (!delBtn) return;
      if (currentMode === 'edit' && selectedBoxIndex >= 0) {
        delBtn.classList.remove('hidden');
      } else {
        delBtn.classList.add('hidden');
      }
    }

    function deleteSelectedBox() {
      const list = redactions[currentPage] || [];
      if (selectedBoxIndex >= 0 && selectedBoxIndex < list.length) {
        list.splice(selectedBoxIndex, 1);
        selectedBoxIndex = -1;
        updateDeleteButton();
        drawCanvasOverlay();
      }
    }

    function undoLastAction() {
      const list = redactions[currentPage] || [];
      if (list.length > 0) {
        list.pop();
        selectedBoxIndex = -1;
        updateDeleteButton();
        drawCanvasOverlay();
      }
    }

    async function handleFile(file) {
      const errBox = document.getElementById('pdf-error');
      if (errBox) errBox.classList.add('hidden');

      const dropTitle = document.querySelector('#pdf-dropzone .drop-title');
      const originalTitle = dropTitle ? dropTitle.innerHTML : '';
      if (dropTitle && (!window.pdfjsLib || !window.PDFLib)) {
        dropTitle.innerHTML = '⚡ Preparing editor...';
      }

      try {
        await loadPdfLibraries();
      } catch (err) {
        if (dropTitle) dropTitle.innerHTML = originalTitle;
        if (errBox) {
          errBox.textContent = 'Could not load PDF processing engine. Please check your internet connection.';
          errBox.classList.remove('hidden');
        }
        return;
      }

      if (dropTitle) dropTitle.innerHTML = originalTitle;

      const reader = new FileReader();
      reader.onload = function () {
        const typedarray = new Uint8Array(reader.result);

        window.pdfjsLib.getDocument(typedarray).promise.then(function (pdf) {
          pdfDoc = pdf;
          pageCount = pdf.numPages;
          currentPage = 1;
          redactions = {};
          selectedBoxIndex = -1;

          // Responsive initial scaling for breathable mobile & desktop fit
          pdf.getPage(1).then(function (firstPage) {
            const unscaled = firstPage.getViewport({ scale: 1.0 });
            const isMobile = window.innerWidth <= 640;
            const isTablet = window.innerWidth <= 1024;
            const maxW = isMobile ? Math.min(window.innerWidth * 0.90, 560) : (isTablet ? Math.min(window.innerWidth * 0.92, 780) : 920);

            if (unscaled.width > maxW) {
              scale = Math.max(0.5, parseFloat((maxW / unscaled.width).toFixed(2)));
            } else {
              scale = isMobile ? 1.0 : 1.3;
            }

            document.getElementById('pdf-dropzone').classList.add('hidden');
            document.getElementById('pdf-workspace').classList.remove('hidden');
            goToStep(1);

            renderPage(currentPage);
          }).catch(function () {
            document.getElementById('pdf-dropzone').classList.add('hidden');
            document.getElementById('pdf-workspace').classList.remove('hidden');
            goToStep(1);
            renderPage(currentPage);
          });
        }).catch(function (err) {
          console.error('PDF render error:', err);
          if (errBox) {
            errBox.textContent = 'Could not render this PDF. Please verify it is a valid document.';
            errBox.classList.remove('hidden');
          }
        });
      };
      reader.readAsArrayBuffer(file);
    }

    function renderPage(num) {
      if (!pdfDoc) return;
      pdfDoc.getPage(num).then(function (page) {
        const viewport = page.getViewport({ scale: scale });
        const canvas = document.getElementById('pdf-render-canvas');
        const overlay = document.getElementById('blackout-overlay-canvas');
        const wrapper = document.getElementById('canvas-wrapper');
        const indicator = document.getElementById('page-indicator');

        const renderWidth = Math.floor(viewport.width);
        const renderHeight = Math.floor(viewport.height);

        canvas.width = renderWidth;
        canvas.height = renderHeight;
        overlay.width = renderWidth;
        overlay.height = renderHeight;

        // Dynamically adjust wrapper dimensions to strictly fit page content
        if (wrapper) {
          wrapper.style.width = 'fit-content';
          wrapper.style.maxWidth = '100%';
          wrapper.style.aspectRatio = `${renderWidth} / ${renderHeight}`;
        }

        const ctx = canvas.getContext('2d');
        page.render({ canvasContext: ctx, viewport: viewport }).promise.then(function () {
          if (indicator) indicator.textContent = currentPage + ' / ' + pageCount;
          drawCanvasOverlay();
        });
      });
    }

    function getCanvasCoords(e) {
      const overlay = document.getElementById('blackout-overlay-canvas');
      const rect = overlay.getBoundingClientRect();
      const touchObj = (e.touches && e.touches.length > 0) ? e.touches[0] : (e.changedTouches && e.changedTouches.length > 0 ? e.changedTouches[0] : e);
      const clientX = touchObj.clientX;
      const clientY = touchObj.clientY;
      const rawX = clientX - rect.left;
      const rawY = clientY - rect.top;
      return {
        x: rawX * (overlay.width / rect.width),
        y: rawY * (overlay.height / rect.height),
        rawX: rawX,
        rawY: rawY
      };
    }

    function updateTouchLoupe(e) {
      const isTouch = (e.touches && e.touches.length > 0) || (e.changedTouches && e.changedTouches.length > 0);
      if (!isTouch) return;

      const loupe = document.getElementById('touch-loupe');
      const loupeCanvas = document.getElementById('loupe-canvas');
      const renderCanvas = document.getElementById('pdf-render-canvas');
      const overlayCanvas = document.getElementById('blackout-overlay-canvas');
      if (!loupe || !loupeCanvas || !renderCanvas || !overlayCanvas) return;

      const p = getCanvasCoords(e);

      loupe.classList.remove('hidden');
      loupe.style.left = p.rawX + 'px';
      loupe.style.top = (p.rawY - 45) + 'px';

      const ctx = loupeCanvas.getContext('2d');
      ctx.clearRect(0, 0, 140, 140);

      const zoom = 2.0;
      const srcW = 140 / zoom;
      const srcH = 140 / zoom;
      const srcX = p.x - (srcW / 2);
      const srcY = p.y - (srcH / 2);

      ctx.drawImage(renderCanvas, srcX, srcY, srcW, srcH, 0, 0, 140, 140);
      ctx.drawImage(overlayCanvas, srcX, srcY, srcW, srcH, 0, 0, 140, 140);
    }

    function hideTouchLoupe() {
      const loupe = document.getElementById('touch-loupe');
      if (loupe) loupe.classList.add('hidden');
    }

    function getNormalizedBox(box, overlay) {
      return {
        x: box.x * (overlay.width / box.cw),
        y: box.y * (overlay.height / box.ch),
        w: box.w * (overlay.width / box.cw),
        h: box.h * (overlay.height / box.ch)
      };
    }

    function getHandlePositions(b) {
      const half = HANDLE_SIZE / 2;
      return {
        nw: { x: b.x - half, y: b.y - half, cursor: 'nwse-resize' },
        ne: { x: b.x + b.w - half, y: b.y - half, cursor: 'nesw-resize' },
        se: { x: b.x + b.w - half, y: b.y + b.h - half, cursor: 'nwse-resize' },
        sw: { x: b.x - half, y: b.y + b.h - half, cursor: 'nesw-resize' },
        n:  { x: b.x + b.w / 2 - half, y: b.y - half, cursor: 'ns-resize' },
        s:  { x: b.x + b.w / 2 - half, y: b.y + b.h - half, cursor: 'ns-resize' },
        w:  { x: b.x - half, y: b.y + b.h / 2 - half, cursor: 'ew-resize' },
        e:  { x: b.x + b.w - half, y: b.y + b.h / 2 - half, cursor: 'ew-resize' }
      };
    }

    function hitTestHandle(p, box, overlay) {
      const b = getNormalizedBox(box, overlay);
      const handles = getHandlePositions(b);
      for (const [key, h] of Object.entries(handles)) {
        if (p.x >= h.x - 3 && p.x <= h.x + HANDLE_SIZE + 3 &&
            p.y >= h.y - 3 && p.y <= h.y + HANDLE_SIZE + 3) {
          return key;
        }
      }
      return null;
    }

    function hitTestBox(p, box, overlay) {
      const b = getNormalizedBox(box, overlay);
      return p.x >= b.x && p.x <= b.x + b.w && p.y >= b.y && p.y <= b.y + b.h;
    }

    function attachCanvasEvents() {
      const overlay = document.getElementById('blackout-overlay-canvas');
      if (!overlay) return;

      const onStart = (e) => {
        if (currentMode === 'scroll' || currentMode === 'review') return;
        const p = getCanvasCoords(e);
        const list = redactions[currentPage] || [];

        if (currentMode === 'blackout') {
          isDrawingNew = true;
          drawStartX = p.x;
          drawStartY = p.y;
          return;
        }

        // EDIT MODE: Check handle first, then box
        if (selectedBoxIndex >= 0 && selectedBoxIndex < list.length) {
          const handle = hitTestHandle(p, list[selectedBoxIndex], overlay);
          if (handle) {
            activeHandle = handle;
            dragStartX = p.x;
            dragStartY = p.y;
            const b = getNormalizedBox(list[selectedBoxIndex], overlay);
            boxInitialState = { ...b };
            return;
          }
        }

        let foundIndex = -1;
        for (let i = list.length - 1; i >= 0; i--) {
          if (hitTestBox(p, list[i], overlay)) {
            foundIndex = i;
            break;
          }
        }

        selectedBoxIndex = foundIndex;
        updateDeleteButton();

        if (foundIndex >= 0) {
          activeHandle = 'move';
          dragStartX = p.x;
          dragStartY = p.y;
          const b = getNormalizedBox(list[foundIndex], overlay);
          boxInitialState = { ...b };
        }

        drawCanvasOverlay();
      };

      const onMove = (e) => {
        if (currentMode === 'scroll' || currentMode === 'review') return;
        const p = getCanvasCoords(e);
        const list = redactions[currentPage] || [];

        // Cursor logic in Edit mode
        if (currentMode === 'edit' && !activeHandle) {
          if (selectedBoxIndex >= 0 && selectedBoxIndex < list.length) {
            const h = hitTestHandle(p, list[selectedBoxIndex], overlay);
            if (h) {
              const handles = getHandlePositions(getNormalizedBox(list[selectedBoxIndex], overlay));
              overlay.style.cursor = handles[h].cursor;
              return;
            }
          }
          let overBox = false;
          for (let i = list.length - 1; i >= 0; i--) {
            if (hitTestBox(p, list[i], overlay)) {
              overBox = true;
              break;
            }
          }
          overlay.style.cursor = overBox ? 'move' : 'default';
        }

        // Drawing a new box in Blackout mode
        if (isDrawingNew && currentMode === 'blackout') {
          drawCanvasOverlay();
          const ctx = overlay.getContext('2d');
          ctx.fillStyle = '#000000';
          ctx.fillRect(
            Math.min(drawStartX, p.x),
            Math.min(drawStartY, p.y),
            Math.abs(p.x - drawStartX),
            Math.abs(p.y - drawStartY)
          );
          return;
        }

        // Resizing or moving in Edit mode
        if (activeHandle && selectedBoxIndex >= 0 && boxInitialState) {
          const dx = p.x - dragStartX;
          const dy = p.y - dragStartY;
          let newBox = { ...boxInitialState };

          if (activeHandle === 'move') {
            newBox.x += dx;
            newBox.y += dy;
          } else if (activeHandle === 'se') {
            newBox.w = Math.max(10, boxInitialState.w + dx);
            newBox.h = Math.max(10, boxInitialState.h + dy);
          } else if (activeHandle === 'sw') {
            const newW = Math.max(10, boxInitialState.w - dx);
            newBox.x = boxInitialState.x + (boxInitialState.w - newW);
            newBox.w = newW;
            newBox.h = Math.max(10, boxInitialState.h + dy);
          } else if (activeHandle === 'ne') {
            const newH = Math.max(10, boxInitialState.h - dy);
            newBox.y = boxInitialState.y + (boxInitialState.h - newH);
            newBox.w = Math.max(10, boxInitialState.w + dx);
            newBox.h = newH;
          } else if (activeHandle === 'nw') {
            const newW = Math.max(10, boxInitialState.w - dx);
            const newH = Math.max(10, boxInitialState.h - dy);
            newBox.x = boxInitialState.x + (boxInitialState.w - newW);
            newBox.y = boxInitialState.y + (boxInitialState.h - newH);
            newBox.w = newW;
            newBox.h = newH;
          } else if (activeHandle === 'e') {
            newBox.w = Math.max(10, boxInitialState.w + dx);
          } else if (activeHandle === 'w') {
            const newW = Math.max(10, boxInitialState.w - dx);
            newBox.x = boxInitialState.x + (boxInitialState.w - newW);
            newBox.w = newW;
          } else if (activeHandle === 's') {
            newBox.h = Math.max(10, boxInitialState.h + dy);
          } else if (activeHandle === 'n') {
            const newH = Math.max(10, boxInitialState.h - dy);
            newBox.y = boxInitialState.y + (boxInitialState.h - newH);
            newBox.h = newH;
          }

          list[selectedBoxIndex] = {
            x: newBox.x,
            y: newBox.y,
            w: newBox.w,
            h: newBox.h,
            cw: overlay.width,
            ch: overlay.height
          };

          drawCanvasOverlay();
        }
      };

      const onEnd = (e) => {
        if (currentMode === 'scroll' || currentMode === 'review') return;
        if (isDrawingNew && currentMode === 'blackout') {
          isDrawingNew = false;
          const p = getCanvasCoords(e.changedTouches ? e.changedTouches[0] : e);
          const w = Math.abs(p.x - drawStartX);
          const h = Math.abs(p.y - drawStartY);

          if (w > 5 && h > 5) {
            if (!redactions[currentPage]) redactions[currentPage] = [];
            redactions[currentPage].push({
              x: Math.min(drawStartX, p.x),
              y: Math.min(drawStartY, p.y),
              w: w,
              h: h,
              cw: overlay.width,
              ch: overlay.height
            });
          }
          drawCanvasOverlay();
          return;
        }

        if (activeHandle) {
          activeHandle = null;
          boxInitialState = null;
          drawCanvasOverlay();
        }
      };

      overlay.addEventListener('mousedown', onStart);
      overlay.addEventListener('mousemove', onMove);
      window.addEventListener('mouseup', onEnd);

      overlay.addEventListener('touchstart', (e) => {
        // 1. Scroll or Review mode: let native browser 1-finger scroll happen naturally
        if (currentMode === 'scroll' || currentMode === 'review') {
          hideTouchLoupe();
          return;
        }

        // 2. Multi-touch (2+ fingers): abort box creation, hide loupe, allow native scrolling/zooming
        if (e.touches && e.touches.length > 1) {
          isDrawingNew = false;
          activeHandle = null;
          hideTouchLoupe();
          drawCanvasOverlay();
          return;
        }

        // 3. Single finger in Blackout or Edit mode: prevent default page scroll and handle action
        e.preventDefault();
        onStart(e);
        if (currentMode === 'blackout') {
          updateTouchLoupe(e);
        }
      }, { passive: false });

      overlay.addEventListener('touchmove', (e) => {
        // 1. Scroll or Review mode: let native touch scrolling happen
        if (currentMode === 'scroll' || currentMode === 'review') {
          return;
        }

        // 2. Multi-touch: abort drawing and let browser handle native pinch/scroll
        if (e.touches && e.touches.length > 1) {
          if (isDrawingNew) {
            isDrawingNew = false;
            drawCanvasOverlay();
          }
          activeHandle = null;
          hideTouchLoupe();
          return;
        }

        // 3. Single finger: prevent page scroll while actively drawing or moving boxes
        e.preventDefault();
        onMove(e);
        if (currentMode === 'blackout' && isDrawingNew) {
          updateTouchLoupe(e);
        }
      }, { passive: false });

      window.addEventListener('touchend', (e) => {
        if (currentMode === 'scroll' || currentMode === 'review') return;
        onEnd(e);
        hideTouchLoupe();
      });

      window.addEventListener('touchcancel', () => {
        isDrawingNew = false;
        activeHandle = null;
        hideTouchLoupe();
        drawCanvasOverlay();
      });
    }

    function drawCanvasOverlay() {
      const overlay = document.getElementById('blackout-overlay-canvas');
      if (!overlay) return;
      const ctx = overlay.getContext('2d');
      ctx.clearRect(0, 0, overlay.width, overlay.height);

      const list = redactions[currentPage] || [];

      list.forEach(function (b, index) {
        const nb = getNormalizedBox(b, overlay);
        ctx.fillStyle = '#000000';
        ctx.fillRect(nb.x, nb.y, nb.w, nb.h);

        // Edit Mode: draw transform border and handles on selected box
        if (currentMode === 'edit' && index === selectedBoxIndex) {
          ctx.strokeStyle = '#3b82f6';
          ctx.lineWidth = 2;
          ctx.strokeRect(nb.x - 1, nb.y - 1, nb.w + 2, nb.h + 2);

          const handles = getHandlePositions(nb);
          ctx.fillStyle = '#ffffff';
          ctx.strokeStyle = '#1d4ed8';
          ctx.lineWidth = 1.5;

          for (const h of Object.values(handles)) {
            ctx.fillRect(h.x, h.y, HANDLE_SIZE, HANDLE_SIZE);
            ctx.strokeRect(h.x, h.y, HANDLE_SIZE, HANDLE_SIZE);
          }
        }
      });
    }

    function stepPage(delta) {
      const next = currentPage + delta;
      if (next >= 1 && next <= pageCount) {
        currentPage = next;
        selectedBoxIndex = -1;
        updateDeleteButton();
        renderPage(currentPage);
      }
    }

    function resetToDropzone() {
      closeShareModal();
      hasDownloaded = false;
      currentStep = 1;
      updateWorkflowStep(1);
      pdfDoc = null;
      currentPage = 1;
      pageCount = 1;
      redactions = {};
      selectedBoxIndex = -1;

      const input = document.getElementById('pdf-file-input');
      if (input) input.value = '';

      const canvas = document.getElementById('pdf-render-canvas');
      const overlay = document.getElementById('blackout-overlay-canvas');
      if (canvas) canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
      if (overlay) overlay.getContext('2d').clearRect(0, 0, overlay.width, overlay.height);

      document.getElementById('pdf-workspace')?.classList.add('hidden');
      document.getElementById('pdf-dropzone')?.classList.remove('hidden');
    }

    function attachShortcuts() {
      window.addEventListener('keydown', function (e) {
        if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) return;

        // B -> Step 1: Blackout Draw Mode
        if ((e.key === 'b' || e.key === 'B') && !e.ctrlKey && !e.metaKey) {
          goToStep(1);
        }

        // E -> Step 2: Review & Edit Mode
        if ((e.key === 'e' || e.key === 'E') && !e.ctrlKey && !e.metaKey) {
          goToStep(2);
        }

        // S -> Toggle Scroll / Pan Mode
        if ((e.key === 's' || e.key === 'S') && !e.ctrlKey && !e.metaKey) {
          toggleScrollMode();
        }

        // Delete / Backspace -> Delete Selected Box
        if ((e.key === 'Delete' || e.key === 'Backspace') && currentMode === 'edit') {
          e.preventDefault();
          deleteSelectedBox();
        }

        // Ctrl + Z -> Undo
        if ((e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z')) {
          e.preventDefault();
          undoLastAction();
        }

        // Arrow navigation
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          stepPage(-1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          stepPage(1);
        }

        // Escape -> Close modal if open, otherwise deselect box
        if (e.key === 'Escape') {
          const shareModal = document.getElementById('share-modal');
          if (shareModal && !shareModal.classList.contains('hidden')) {
            closeShareModal();
            return;
          }
          selectedBoxIndex = -1;
          updateDeleteButton();
          drawCanvasOverlay();
        }
      }, true);
    }

    // Fast Client-Side PDF Flattening & Binary JPEG Generation
    async function downloadFlattenedRedacted() {
      const btn = document.getElementById('btn-download');
      const overlay = document.getElementById('export-loading-overlay');
      const overlayTitle = document.getElementById('export-status-title');
      const overlayPage = document.getElementById('export-status-page');
      const shareModal = document.getElementById('share-modal');
      if (!btn || !pdfDoc) return;

      // 1. Ensure Step 4 viral modal is completely hidden during export
      if (shareModal) {
        shareModal.classList.remove('active');
        shareModal.classList.add('hidden');
      }

      // Lock scroll position before export processing
      const savedScrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
      const originalHtml = btn.innerHTML;

      // Keep user on Step 3 with active export spinner
      updateWorkflowStep(3);
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      btn.style.cursor = 'progress';
      btn.innerHTML = `<svg class="btn-spinner" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3.5" stroke-dasharray="32" stroke-linecap="round" opacity="0.3"></circle><path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"></path></svg><span>Exporting...</span>`;

      if (overlay) {
        if (overlayTitle) overlayTitle.textContent = 'Exporting secure PDF...';
        if (overlayPage) overlayPage.textContent = pageCount > 1 ? `Processing ${pageCount} pages...` : 'Zero server uploads · True vector rasterization';
        overlay.classList.remove('hidden');
        void overlay.offsetHeight; // Force reflow
        overlay.classList.add('active');
      }

      // 100ms repaint tick so spinner and overlay start smoothly
      await new Promise(function (resolve) { setTimeout(resolve, 100); });

      let downloadUrl = null;

      try {
        await loadPdfLibraries();
        if (!window.PDFLib) throw new Error('PDFLib is unavailable');

        const { PDFDocument } = window.PDFLib;
        const newPdf = await PDFDocument.create();

        for (let i = 1; i <= pageCount; i++) {
          if (overlayTitle && pageCount > 1) {
            overlayTitle.textContent = `Exporting secure PDF (${i}/${pageCount})...`;
          }

          // Minimal tick so the browser animation thread continues running smoothly
          await new Promise(function (resolve) { setTimeout(resolve, 10); });

          const page = await pdfDoc.getPage(i);
          const renderScale = 2.0;
          const viewport = page.getViewport({ scale: renderScale });

          const offscreenCanvas = document.createElement('canvas');
          offscreenCanvas.width = viewport.width;
          offscreenCanvas.height = viewport.height;
          const ctx = offscreenCanvas.getContext('2d');

          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, viewport.width, viewport.height);

          await page.render({ canvasContext: ctx, viewport: viewport }).promise;

          const pageBoxes = redactions[i] || [];
          if (pageBoxes.length > 0) {
            ctx.fillStyle = '#000000';
            pageBoxes.forEach(function (b) {
              const rx = (b.x / b.cw) * viewport.width;
              const ry = (b.y / b.ch) * viewport.height;
              const rw = (b.w / b.cw) * viewport.width;
              const rh = (b.h / b.ch) * viewport.height;
              ctx.fillRect(rx, ry, rw, rh);
            });
          }

          // Convert canvas directly to binary JPEG blob (bypassing slow base64 serialization)
          const jpgBlob = await new Promise(function (resolve, reject) {
            offscreenCanvas.toBlob(function (blob) {
              if (blob) resolve(blob);
              else reject(new Error('Failed to encode JPEG blob'));
            }, 'image/jpeg', 0.90);
          });
          const arrayBuffer = await jpgBlob.arrayBuffer();
          const jpgImage = await newPdf.embedJpg(new Uint8Array(arrayBuffer));

          // Immediately clean up canvas memory to avoid garbage collection spikes
          offscreenCanvas.width = 0;
          offscreenCanvas.height = 0;

          const targetWidth = viewport.width / renderScale;
          const targetHeight = viewport.height / renderScale;
          const newPage = newPdf.addPage([targetWidth, targetHeight]);
          newPage.drawImage(jpgImage, {
            x: 0,
            y: 0,
            width: targetWidth,
            height: targetHeight
          });
        }

        if (overlayTitle) overlayTitle.textContent = 'Finalizing your download...';
        await new Promise(function (resolve) { setTimeout(resolve, 10); });

        const pdfBytes = await newPdf.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        downloadUrl = URL.createObjectURL(blob);
        
        // Create isolated offscreen anchor with zero scroll impact and no focus
        const a = document.createElement('a');
        a.style.display = 'none';
        a.style.position = 'fixed';
        a.style.top = '-9999px';
        a.style.left = '-9999px';
        a.style.opacity = '0';
        a.tabIndex = -1;
        a.setAttribute('aria-hidden', 'true');
        a.href = downloadUrl;
        a.download = 'blackout-redacted.pdf';
        document.body.appendChild(a);
        
        // Trigger browser save dialog
        a.click();
        document.body.removeChild(a);

        // Lock scroll immediately after click
        window.scrollTo({ top: savedScrollY, behavior: 'instant' });

        hasDownloaded = true;

        // Ensure browser receives the download intent before transition
        await new Promise(function (resolve) { setTimeout(resolve, 350); });

        // Fade out workspace loading overlay before displaying celebration modal
        if (overlay) {
          overlay.classList.remove('active');
          await new Promise(function (resolve) { setTimeout(resolve, 200); });
          overlay.classList.add('hidden');
        }

        // Open celebration & viral share modal (Step 4) ONLY after download hand-off is complete
        openShareModal();
      } catch (err) {
        console.error('Export flattening error:', err);
        const errBox = document.getElementById('pdf-error');
        if (errBox) {
          errBox.textContent = 'An error occurred while generating the redacted PDF. Please try again.';
          errBox.classList.remove('hidden');
        }
      } finally {
        if (downloadUrl) {
          URL.revokeObjectURL(downloadUrl);
        }
        if (overlay && !overlay.classList.contains('hidden')) {
          overlay.classList.remove('active');
          overlay.classList.add('hidden');
        }
        btn.innerHTML = originalHtml;
        btn.removeAttribute('aria-busy');
        btn.style.cursor = '';
        btn.disabled = false;

        // Restore exact scroll position
        window.scrollTo({ top: savedScrollY, behavior: 'instant' });
      }
    }

    window.addEventListener('languagechange', (e) => {
      if (e.detail && e.detail.dict) {
        window.__pdfDict = e.detail.dict;
        const statusPill = document.getElementById('status-pill');
        if (statusPill) {
          const key = statusPill.getAttribute('data-i18n') || (currentMode === 'scroll' ? 'modeScrollPill' : (currentStep === 1 ? 'step1Status' : (currentStep === 2 ? 'step2Status' : 'step3Status')));
          if (e.detail.dict[key]) {
            statusPill.innerHTML = e.detail.dict[key];
          }
        }
        const shareX = document.getElementById('share-link-x');
        const shareReddit = document.getElementById('share-link-reddit');
        if (shareX && e.detail.dict.shareXText) {
          shareX.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(e.detail.dict.shareXText)}&url=https%3A%2F%2Fredactfree.com&via=thehypewipe`;
        }
        if (shareReddit && e.detail.dict.shareRedditTitle) {
          shareReddit.href = `https://www.reddit.com/submit?url=https%3A%2F%2Fredactfree.com&title=${encodeURIComponent(e.detail.dict.shareRedditTitle)}`;
        }
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
