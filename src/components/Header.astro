---
// src/components/Header.astro — Vercel-style top navigation with Language & Theme switchers
import LanguageSwitcher from './LanguageSwitcher.astro';
import { defaultLang, type SupportedLocale } from '../i18n/ui';
import { useTranslations, getLocalizedUrl } from '../i18n/utils';

interface Props {
  currentLang?: SupportedLocale;
}

const { currentLang = (Astro.currentLocale as SupportedLocale) || defaultLang } = Astro.props;
const t = useTranslations(currentLang);

const navLinks = [
  { href: '/about', label: t('navAbout') || 'About', i18n: 'navAbout' },
  { href: '/privacy', label: t('navPrivacy') || 'Privacy', i18n: 'navPrivacy' },
  { href: '/contact', label: t('navContact') || 'Contact', i18n: 'navContact' },
];
const currentPath = Astro.url.pathname;
const homeUrl = getLocalizedUrl('/', currentLang);
const editorAnchor = `${homeUrl}#editor`;
---

<header class="site-header">
  <nav class="container header-inner" aria-label="Main navigation">
    <a href={homeUrl} class="wordmark" aria-label="PDF Redact Free Home">
      <svg class="wordmark-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#ffffff"/>
        <rect x="6" y="13" width="20" height="6" rx="2" fill="#000000"/>
      </svg>
      <span>PDF Redact Free</span>
    </a>

    <ul class="nav-links" role="list">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: currentPath === link.href }]}
            aria-current={currentPath === link.href ? 'page' : undefined}
            data-i18n={link.i18n}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="header-actions">
      <LanguageSwitcher currentLang={currentLang} />
      <button
        id="theme-toggle-btn"
        type="button"
        class="theme-toggle-btn"
        aria-label="Toggle light and dark mode"
        title="Toggle Theme"
      >
        <span id="theme-toggle-icon" aria-hidden="true">🌙</span>
      </button>
      <a href={editorAnchor} class="btn-sm-primary" data-i18n="navRedactFree">{t('navRedactFree') || 'Redact PDF Free'}</a>
    </div>

    <!-- Mobile menu button -->
    <button class="menu-toggle" id="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- Mobile drawer -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <ul role="list">
      {navLinks.map(link => (
        <li><a href={link.href} class="mobile-nav-link" data-i18n={link.i18n}>{link.label}</a></li>
      ))}
      <li style="padding: 10px 0; display: flex; align-items: center; justify-content: space-between;">
        <span style="font-size: 14px; color: var(--color-body);">Language &amp; Theme</span>
        <div style="display: flex; align-items: center; gap: 8px;">
          <button
            id="mobile-theme-toggle-btn"
            type="button"
            class="theme-toggle-btn"
            aria-label="Toggle light and dark mode"
          >
            <span id="mobile-theme-toggle-icon" aria-hidden="true">🌙</span>
          </button>
        </div>
      </li>
      <li><a href={editorAnchor} class="btn-sm-primary" style="width:100%;justify-content:center;margin-top:8px;" data-i18n="navRedactFree">{t('navRedactFree') || 'Redact PDF Free'}</a></li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  /* Wordmark */
  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: var(--color-ink);
    text-decoration: none;
    flex-shrink: 0;
  }
  .wordmark:hover { opacity: 1; }
  .wordmark-icon { flex-shrink: 0; }

  /* Nav Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 var(--space-sm);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover {
    color: var(--color-ink);
    background: var(--color-hairline-soft);
    opacity: 1;
  }
  .nav-link.active {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* Mobile menu button */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    gap: 5px;
    background: transparent;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 0;
  }
  .menu-toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-toggle.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menu-toggle.open span:nth-child(2) { opacity: 0; }
  .menu-toggle.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* Mobile drawer */
  .mobile-menu {
    display: none;
    padding: var(--space-sm) var(--space-lg) var(--space-lg);
    border-top: 1px solid var(--color-hairline);
    background: var(--color-canvas);
  }
  .mobile-menu ul { list-style: none; }
  .mobile-nav-link {
    display: block;
    padding: var(--space-sm) 0;
    font-size: 15px;
    color: var(--color-body);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hairline-soft);
  }
  .mobile-nav-link:hover { color: var(--color-ink); opacity: 1; }

  @media (max-width: 640px) {
    .nav-links { display: none; }
    .header-actions .btn-sm-primary { display: none; }
    .menu-toggle { display: flex; }
    .mobile-menu.open { display: block; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.classList.toggle('open');
    menu?.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    if (menu) menu.setAttribute('aria-hidden', String(!open));
  });

  const themeBtn = document.getElementById('theme-toggle-btn');
  const themeIcon = document.getElementById('theme-toggle-icon');
  const mobileThemeBtn = document.getElementById('mobile-theme-toggle-btn');
  const mobileThemeIcon = document.getElementById('mobile-theme-toggle-icon');

  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    const icon = isDark ? '☀️' : '🌙';
    if (themeIcon) themeIcon.textContent = icon;
    if (mobileThemeIcon) mobileThemeIcon.textContent = icon;
  }

  updateThemeIcons();

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeIcons();
  }

  themeBtn?.addEventListener('click', toggleTheme);
  mobileThemeBtn?.addEventListener('click', toggleTheme);
</script>
