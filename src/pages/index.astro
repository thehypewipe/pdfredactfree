---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustBadge from '../components/TrustBadge.astro';
import PdfEditor from '../components/PdfEditor.astro';
import Guide from '../components/Guide.astro';
import { useTranslations } from '../i18n/utils';

const currentLang = 'en';
const t = useTranslations(currentLang);
---

<Layout
  title={t('metaTitle')}
  description={t('metaDescription')}
  canonical="https://redactfree.com/"
  injectFaqSchema={true}
  lang={currentLang}
>
  <Header currentLang={currentLang} />

  <main id="main-content">

    <!-- ── Hero ── -->
    <section class="hero-band" aria-labelledby="hero-heading">
      <div class="hero-mesh" aria-hidden="true"></div>
      <div class="container hero-content">
        <p class="mono-eyebrow hero-eyebrow" data-i18n="heroEyebrow">{t('heroEyebrow')}</p>
        <h1 id="hero-heading" class="display-xl hero-heading" data-i18n="heroTitle">
          <Fragment set:html={t('heroTitle')} />
        </h1>
        <p class="body-lg hero-sub" data-i18n="heroSubtitle">
          {t('heroSubtitle')}
        </p>
        <div class="hero-actions">
          <a href="#editor" class="btn-primary hero-cta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" fill="currentColor" stroke="none"/>
            </svg>
            <span data-i18n="heroCta">{t('heroCta')}</span>
          </a>
          <a href="#how-to" class="btn-secondary" data-i18n="heroHow">{t('heroHow')}</a>
        </div>
        <div class="hero-keywords" aria-hidden="true">
          <span>{t('keyword1')}</span><span>{t('keyword2')}</span><span>{t('keyword3')}</span><span>{t('keyword4')}</span>
        </div>
      </div>
    </section>

    <!-- ── Editor ── -->
    <section class="editor-section" id="editor" aria-labelledby="editor-heading">
      <div class="container">
        <TrustBadge currentLang={currentLang} />
        <h2 id="editor-heading" class="sr-only">PDF Redaction Tool</h2>
        <PdfEditor currentLang={currentLang} />
      </div>
    </section>

    <!-- ── Feature Cards ── -->
    <section class="section features-section" aria-labelledby="features-heading">
      <div class="container">
        <p class="mono-eyebrow section-eyebrow" data-i18n="secWhyTitle">{t('secWhyTitle')}</p>
        <h2 id="features-heading" class="heading-lg section-title" data-i18n="secSecureDesign">{t('secSecureDesign')}</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="heading-md feature-title" data-i18n="secZeroUploads">{t('secZeroUploads')}</h3>
            <p class="body-md feature-body" data-i18n="secZeroUploadsDesc">{t('secZeroUploadsDesc')}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" fill="currentColor" stroke="none"/></svg>
            </div>
            <h3 class="heading-md feature-title" data-i18n="secTrueRedaction">{t('secTrueRedaction')}</h3>
            <p class="body-md feature-body" data-i18n="secTrueRedactionDesc">{t('secTrueRedactionDesc')}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <h3 class="heading-md feature-title" data-i18n="secMultiPage">{t('secMultiPage')}</h3>
            <p class="body-md feature-body" data-i18n="secMultiPageDesc">{t('secMultiPageDesc')}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <h3 class="heading-md feature-title" data-i18n="secNoAdobe">{t('secNoAdobe')}</h3>
            <p class="body-md feature-body" data-i18n="secNoAdobeDesc">{t('secNoAdobeDesc')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SEO Guide & FAQ ── -->
    <Guide currentLang={currentLang} />

    <!-- ── CTA Band ── -->
    <section class="cta-band" aria-labelledby="cta-heading">
      <div class="container cta-content">
        <h2 id="cta-heading" class="heading-lg cta-title">Redact your PDF now — free, private, permanent.</h2>
        <p class="body-lg cta-sub">No account. No uploads. No Adobe. Just open, blackout, download.</p>
        <a href="#editor" class="btn-primary">Get Started Free</a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .hero-band {
    position: relative;
    background: var(--color-canvas);
    padding: var(--space-section) 0 var(--space-4xl);
    overflow: hidden;
    text-align: center;
  }

  .hero-mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 20% 40%, rgba(0,124,240,0.08) 0%, transparent 70%),
      radial-gradient(ellipse 50% 60% at 80% 20%, rgba(121,40,202,0.07) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 60% 80%, rgba(255,0,128,0.05) 0%, transparent 70%),
      radial-gradient(ellipse 50% 50% at 40% 60%, rgba(80,227,194,0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-content { position: relative; z-index: 1; }

  .hero-eyebrow { margin-bottom: var(--space-lg); }

  .hero-heading {
    color: var(--color-ink);
    margin-bottom: var(--space-lg);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-sub {
    color: var(--color-body);
    max-width: 560px;
    margin: 0 auto var(--space-xl);
    font-size: 17px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .hero-cta {
    font-size: 16px;
    height: 44px;
    padding: 0 22px;
  }

  /* --- High Contrast Keyword Badges (WCAG AAA) --- */
  .hero-keywords {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero-keywords span {
    font-size: 12px;
    font-weight: 600;
    color: #f4f4f5;
    background: #18181b;
    border: 1px solid #3f3f46;
    font-family: 'Geist Mono', monospace;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
  }
  :global([data-theme="dark"]) .hero-keywords span {
    background: #18181b;
    border-color: #52525b;
    color: #fafafa;
  }

  /* ── Editor Section with CLS Protection ── */
  .editor-section {
    padding: var(--space-2xl) 0 var(--space-4xl);
    background: var(--color-canvas);
    min-height: 520px;
    contain: style;
  }

  /* ── Features ── */
  .features-section { background: var(--color-canvas); }
  .section-eyebrow { margin-bottom: var(--space-sm); }
  .section-title { margin-bottom: var(--space-2xl); color: var(--color-ink); }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .feature-icon {
    color: var(--color-ink);
    margin-bottom: var(--space-md);
  }
  .feature-title { margin-bottom: var(--space-sm); color: var(--color-ink); }
  .feature-body { color: var(--color-body); line-height: 1.6; }

  /* ── Content ── */
  .content-section { background: var(--color-canvas); }
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: var(--space-3xl);
    align-items: start;
  }
  .space-y-2 > * + * { margin-top: 0.5rem; }
  .text-sm { font-size: 0.875rem; }
  .text-zinc-600 { color: #52525b; }
  .text-zinc-900 { color: #18181b; }
  .flex { display: flex; }
  .justify-between { justify-content: space-between; }
  .py-1 { padding-top: 0.25rem; padding-bottom: 0.25rem; }
  .border-b { border-bottom: 1px solid; }
  .border-zinc-100 { border-color: #f4f4f5; }
  .font-mono { font-family: 'Geist Mono', monospace; font-size: 0.78rem; }
  .font-bold { font-weight: 700; }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .sidebar-list li {
    font-size: 13px;
    color: var(--color-body);
    display: flex;
    gap: var(--space-sm);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-hairline-soft);
  }
  .sidebar-list li:last-child { border-bottom: none; padding-bottom: 0; }
  .sidebar-list strong {
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    color: var(--color-ink);
    min-width: 56px;
    flex-shrink: 0;
  }

  /* ── FAQ ── */
  .faq-section { background: var(--color-canvas-elevated); }
  .faq-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .faq-item {
    border-bottom: 1px solid var(--color-hairline);
  }
  .faq-item:last-child { border-bottom: none; }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) var(--space-xl);
    cursor: pointer;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--color-ink);
    list-style: none;
    transition: background 0.15s ease;
    gap: var(--space-md);
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question:hover { background: var(--color-hairline-soft); }
  details[open] .faq-question { background: var(--color-hairline-soft); }

  .faq-icon {
    color: var(--color-mute);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  details[open] .faq-icon { transform: rotate(180deg); }

  .faq-answer {
    padding: 0 var(--space-xl) var(--space-lg);
    background: var(--color-canvas-elevated);
  }
  .faq-answer p {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--color-body);
  }

  /* ── CTA Band ── */
  .cta-band {
    background: var(--color-canvas);
    padding: var(--space-4xl) 0;
    text-align: center;
    border-top: 1px solid var(--color-hairline);
  }
  .cta-title { color: var(--color-ink); margin-bottom: var(--space-md); }
  .cta-sub { color: var(--color-body); margin-bottom: var(--space-xl); }

  /* ── SR Only ── */
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
    .content-grid { grid-template-columns: 1fr; }
    .content-sidebar { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
    .content-sidebar .feature-card:last-child { margin-top: 0 !important; }
  }
  @media (max-width: 640px) {
    .editor-section { padding: var(--space-lg) 0 var(--space-2xl); min-height: 440px; }
    .features-grid { grid-template-columns: 1fr; }
    .hero-band { padding: var(--space-3xl) 0 var(--space-2xl); }
    .content-sidebar { grid-template-columns: 1fr; }
    .faq-question { padding: var(--space-md) var(--space-lg); }
    .faq-answer { padding: 0 var(--space-lg) var(--space-md); }
  }
</style>
